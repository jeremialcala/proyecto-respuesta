{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeMediaStoredQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:sa-east-1:ACCOUNT_ID:respuesta-media-stored",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    },
    {
      "Sid": "ReadEncryptedMedia",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::respuesta-media/encrypted/*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    },
    {
      "Sid": "DecryptMediaForEmbedding",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:sa-east-1:ACCOUNT_ID:key/KEY_ID_MEDIA",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    },
    {
      "Sid": "PublishCandidateGenerated",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:sa-east-1:ACCOUNT_ID:respuesta-candidate-generated",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    }
  ]
}
