{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeMetaReceivedQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility"
      ],
      "Resource": "arn:aws:sqs:sa-east-1:ACCOUNT_ID:respuesta-meta-received",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    },
    {
      "Sid": "PublishInboundTopics",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:sa-east-1:ACCOUNT_ID:respuesta-inbound-text",
        "arn:aws:sns:sa-east-1:ACCOUNT_ID:respuesta-inbound-media"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    },
    {
      "Sid": "PerEventJwkEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:sa-east-1:ACCOUNT_ID:key/KEY_ID_EVENTS",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "sa-east-1" }
      }
    }
  ]
}
