# Env del NODO de inferencia en vast.ai — variante "BUS LOCAL por túnel" (ADR-0019, corrida local).
# Copia a `env.vast.local` y rellena. A diferencia de env.vast.example (bus en AWS real), aquí el bus es
# tu LocalStack expuesto por túnel: las credenciales AWS son DUMMY (LocalStack las ignora) y el destino
# del bus es la URL del túnel. La imagen sí vive en ECR (login de corta vida solo para el pull).
#
# NOTA: comentarios SOLO en líneas propias (launch convierte cada KEY=VAL en un flag `-e`).
# NOTA: AWS_ENDPOINT_URL y SQS_EXTRACT_QUEUE_URL los SOBREESCRIBE launch-ondemand.sh con TUNNEL_URL
#       (el host trycloudflare/ngrok cambia en cada arranque). Los de aquí son solo placeholders.

AWS_REGION=sa-east-1
# Credenciales DUMMY: el bus es LocalStack, no AWS real. No pongas claves reales aquí.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Bus = LocalStack vía túnel. launch-ondemand.sh reemplaza estos dos con TUNNEL_URL en cada corrida:
AWS_ENDPOINT_URL=https://REEMPLAZA.trycloudflare.com
SQS_EXTRACT_QUEUE_URL=https://REEMPLAZA.trycloudflare.com/000000000000/face-extract-requested
# El ARN no depende del host (LocalStack resuelve por ARN); cuenta dummy 000000000000:
SNS_FACE_EMBEDDED_ARN=arn:aws:sns:sa-east-1:000000000000:face-embedded

# Inferencia (GPU on-demand):
ARCFACE_USE_GPU=true
ARCFACE_MODEL_ROOT=/models/insightface
PRODUCER=inference-worker-vastai-local
LOG_LEVEL=INFO
