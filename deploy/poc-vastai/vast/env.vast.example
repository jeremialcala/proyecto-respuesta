# Variables de entorno del NODO de inferencia en vast.ai (ADR-0019). Copia a `env.vast` y rellena.
# El nodo solo habla con el bus en sa-east-1 con credenciales de ALCANCE MÍNIMO (iam-inference-policy.json).
# RECOMENDADO: credenciales STS de corta vida (AWS_SESSION_TOKEN), no claves de larga vida (§4).
# NOTA: comentarios SOLO en líneas propias (launch.sh convierte cada línea KEY=VAL en un flag `-e`).

AWS_REGION=sa-east-1
# Usuario IAM mínimo o (recomendado) credenciales STS temporales:
AWS_ACCESS_KEY_ID=ASIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=REEMPLAZAR
# Presente solo si usas STS (recomendado). Borra esta línea si usas un usuario IAM de larga vida:
AWS_SESSION_TOKEN=REEMPLAZAR

# Bus (salida de aws-bootstrap.sh):
SQS_EXTRACT_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/ACCOUNT_ID/face-extract-requested
SNS_FACE_EMBEDDED_ARN=arn:aws:sns:sa-east-1:ACCOUNT_ID:face-embedded

# Inferencia:
ARCFACE_USE_GPU=true
ARCFACE_MODEL_ROOT=/models/insightface
PRODUCER=inference-worker-vastai
LOG_LEVEL=INFO
