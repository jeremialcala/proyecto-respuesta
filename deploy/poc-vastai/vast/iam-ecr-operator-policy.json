{
  "Version": "2012-10-17",
  "Comment": "ADR-0019 PoC. Politica MINIMA del OPERADOR que construye y empuja la imagen de inferencia a ECR (build/push). NO es la del nodo en runtime (esa es iam-inference-policy.json: solo SQS/SNS). Reemplaza <ACCOUNT_ID> y, si quieres, restringe el repo.",
  "Statement": [
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrRepoManageAndPush",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:sa-east-1:<ACCOUNT_ID>:repository/respuesta/matching-worker-inference"
    }
  ]
}
