# syntax=docker/dockerfile:1.7
# Imagen de INFERENCIA ArcFace portable (ADR-0019) — DISTINTA de la imagen de control (`Dockerfile`).
# Stateless: consume `face.extract.requested`, devuelve `face.embedded` (solo vectores). Sin DB/Vault/S3.
# Pensada para GPU dedicada (ADR-0018) y burst on-demand verificado (vast.ai Secure Cloud / EKS / on-prem);
# el destino es CONFIGURACIÓN, no código. Reusa el paquete `matching_worker` (DRY).
#
# Serving objetivo: TensorRT con el engine ArcFace/IResNet100 PRE-COMPILADO y horneado, para evitar el
# cold-start de compilar en cada arranque (clave para el escalado elástico — ADR-0019 §1).
#   TODO(decisión abierta ADR-0019): el baking del engine requiere GPU + el modelo en build (no se hace
#   aquí). Distribución del engine (horneado en la imagen vs volumen de solo-lectura versionado por
#   model=arcface/version=iresnet100) pendiente. Mientras tanto, InsightFace/ONNX-GPU sirve de base
#   portable (la misma que el worker), seleccionable sin cambiar el código del servicio.
# Base CUDA 12.4 + cuDNN 9: el onnxruntime-gpu actual (>=1.19) requiere cuDNN 9; una base cudnn8 hace
# que el CUDAExecutionProvider NO cargue (cae a CPU en silencio). Driver del host >=550 lo soporta.
ARG TRT_BASE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
FROM ${TRT_BASE} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3-pip python3-dev build-essential libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --upgrade pip "setuptools>=68" wheel \
    && pip3 install --timeout=120 --retries=10 . \
    # insightface declara `onnxruntime` (CPU) y pisa a `onnxruntime-gpu` (mismo paquete) → el provider
    # CUDA desaparece y la inferencia cae a CPU. Dejamos SOLO onnxruntime-gpu y verificamos en build.
    && pip3 uninstall -y onnxruntime onnxruntime-gpu \
    && pip3 install --timeout=120 --retries=10 "onnxruntime-gpu>=1.19,<1.24" \
    && python3 -c "import onnxruntime as o; p=o.get_available_providers(); print('ORT providers:', p); assert 'CUDAExecutionProvider' in p, p"
ENV PYTHONPATH=/app/src
# Modelos en un directorio escribible por el no-root (o un volumen de solo-lectura con el engine horneado).
RUN mkdir -p /models && chown -R 10001:10001 /models
ENV ARCFACE_MODEL_ROOT=/models/insightface
# Sin secretos en el nodo: recibe trabajo y devuelve vector vía el bus (ADR-0019 §4). Sin puerto HTTP.
USER 10001
CMD ["python3","-m","matching_worker.inference_main"]
