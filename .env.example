# Copia a .env y ajusta. Credenciales de Meta del bot del MVP (WhatsApp Business).
META_BOT_ID=bot-dev
META_VERIFY_TOKEN=verify-dev
META_APP_SECRET=app-secret-dev

# Graph API (envío real por WhatsApp Cloud API). Déjalos con el placeholder para dev sin token.
# Con token real: rellena ambos y pon OUTPUT_DRY_RUN=false para que el output-service envíe de verdad.
META_GRAPH_TOKEN=graph-token-dev
WA_PHONE_NUMBER_ID=000000000000000
OUTPUT_DRY_RUN=true
# Plantilla HSM aprobada para respuestas FUERA de la ventana de 24h (dentro se envía texto libre).
# Debe existir y estar aprobada en tu WABA, con el idioma correcto (p. ej. hello_world / en_US).
HSM_TEMPLATE=jornada_update
HSM_LANG=es

# --- Chatbot / Ollama on-prem (ADR-0001/0015) ---
# OLLAMA_URL por defecto apunta al Ollama del host. Modelos grandes (27B) en frío superan 60s:
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m
# LLM_MODEL=gemma3:27b
# Embeddings de memoria de conversación: requiere el modelo descargado (`ollama pull nomic-embed-text`).
# Si no lo tienes, deja EMBED_MODEL vacío para usar solo la ventana reciente (sin recuperación):
# EMBED_MODEL=

# En AWS real estas variables apuntan a SQS/SNS/RDS/ElastiCache; en local las fija docker-compose.
